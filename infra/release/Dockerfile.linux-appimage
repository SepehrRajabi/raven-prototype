FROM ubuntu:22.04@sha256:0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982

ARG RUST_TOOLCHAIN=1.96.0
ARG TAURI_CLI_VERSION=2.11.2
# rustup-init for x86_64 Linux, checked against the hash rustup publishes beside it
# (https://static.rust-lang.org/rustup/archive/<version>/x86_64-unknown-linux-gnu/rustup-init.sha256).
# When bumping the version, take the hash from that file and check it against a download.
ARG RUSTUP_VERSION=1.29.2
ARG RUSTUP_INIT_SHA256=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo-bootstrap
ENV PATH=/opt/cargo-bootstrap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    file \
    git \
    libasound2-dev \
    libayatana-appindicator3-dev \
    libclang-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer1.0-dev \
    libgtk-3-dev \
    libpipewire-0.3-dev \
    librsvg2-dev \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    meson \
    nasm \
    ninja-build \
    patchelf \
    pkg-config \
    wget \
    xdg-utils \
    yasm \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
      https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init -o /tmp/rustup-init \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict - \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain ${RUST_TOOLCHAIN} \
    && rm /tmp/rustup-init \
    && cargo install tauri-cli --version ${TAURI_CLI_VERSION} --locked \
    && install -m 0755 /opt/cargo-bootstrap/bin/cargo-tauri /usr/local/bin/cargo-tauri \
    && rustc --version \
    && cargo-tauri --version

ENV CARGO_HOME=/cargo-cache
ENV APPIMAGE_EXTRACT_AND_RUN=1

