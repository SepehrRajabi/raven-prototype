{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Raven's main window: window controls, opening links in the system browser, creating its picture-in-picture windows, and every Raven command (the generated main-window set; see app_commands.rs)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-overlay-icon",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-resize-dragging",
    "core:webview:allow-create-webview-window",
    "main-window"
  ]
}
