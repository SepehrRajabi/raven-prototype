{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "secondary",
  "description": "Nest and Studio windows (not opened by the current UI): window controls only. They cannot open further windows; the Studio window gets the mixer commands from studio.json",
  "windows": ["nest-window-*", "studio-window-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-resize-dragging"
  ]
}
