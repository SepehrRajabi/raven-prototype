{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven",
  "version": "0.1.11",
  "identifier": "app.raven.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Raven",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [],
    "resources": ["THIRD-PARTY-NOTICES.md"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRTMzMjMzNUFEMTczQTIKUldTaWM5RmFNekxqRUluWjlHR2NSR3BXb3ZEVHVxWTdPS2c4bU5OcE1MalBBdDRydkJwNTZwVmgK",
      "endpoints": [
        "https://updates.rvn.bluehour.cloud/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
