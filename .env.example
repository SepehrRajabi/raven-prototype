# Raven API
RAVEN_API_ADDR=127.0.0.1:6977
RAVEN_SERVER_NAME=Raven
RAVEN_SERVER_DESCRIPTION=Desktop RTC for private Nests
RAVEN_SERVER_AVATAR=
RAVEN_VERSION=0.1.0
RAVEN_MINIMUM_CLIENT_VERSION=0.1.0

# Database
# If DATABASE_URL or RAVEN_DATABASE_URL is set, Raven uses PostgreSQL.
# Leave these unset to use the local SQLite fallback at RAVEN_DATABASE_PATH.
DATABASE_URL=postgres://raven:change-me@127.0.0.1:5432/raven?sslmode=disable

# Alternative PostgreSQL settings if you do not want to use DATABASE_URL.
# RAVEN_DATABASE_DRIVER=postgres
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=raven
# POSTGRES_USER=raven
# POSTGRES_PASSWORD=change-me
# POSTGRES_SSLMODE=disable

# SQLite fallback, used only when no PostgreSQL env vars are set.
RAVEN_DATABASE_PATH=data/raven.db

# LiveKit
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me
# Production-only public address advertised by the homelab LiveKit server.
# LIVEKIT_NODE_IP=203.0.113.10

# Set RAVEN_MEDIA_DIR to keep media in a directory instead of S3 (the S3_* values are then ignored).
# RAVEN_MEDIA_DIR=/var/lib/raven/media
S3_ENDPOINT=https://storage.example.invalid
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=raven
RAVEN_MEDIA_PREFIX=profile-images
RAVEN_CHAT_MEDIA_PREFIX=chat-attachments
# Link previews in chat: the server reads the pages people link to (public addresses only).
# RAVEN_LINK_PREVIEWS=on
